4px' }}>\n                    Delete my recordings\n                  </div>\n                </div>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-foreground)', fontFamily: '\"Inter\", system-ui, sans-serif', fontSize: '16px', lineHeight: '24px' }}>\n                  Deleted 14 recordings.\n                </div>\n              </div>\n            </div>\n            <div style={{ backgroundColor: 'var(--color-background)', borderColor: 'var(--color-border)', borderStyle: 'solid', borderTopLeftRadius: 'var(--radius-sheet)', borderTopRightRadius: 'var(--radius-sheet)', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', gap: '16px', paddingBottom: '20px', paddingInline: '20px', paddingTop: '12px', width: '390px' }}>\n              <div style={{ alignSelf: 'center', backgroundColor: 'var(--color-border)', borderRadius: '999px', boxSizing: 'border-box', flexShrink: '0', height: '6px', width: '48px' }} />\n              <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '4px' }}>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-foreground)', fontFamily: '\"Inter\", system-ui, sans-serif', fontSize: '20px', fontWeight: 600, lineHeight: '28px' }}>\n                  Delete your recordings?\n                </div>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-muted-foreground)', fontFamily: '\"Inter\", system-ui, sans-serif', fontSize: '16px', lineHeight: '24px' }}>\n                  This can't be undone. A copy held by the speech provider follows its own policy.\n                </div>\n              </div>\n              <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '8px' }}>\n                <div style={{ alignItems: 'center', backgroundColor: 'var(--color-destructive)', borderRadius: 'var(--radius-lg)', boxSizing: 'border-box', display: 'flex', flexShrink: 