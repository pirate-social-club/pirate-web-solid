          "HNS_HANDLE_HOST_AUTHORITY_ACCESS_CLIENT_SECRET"
        ]
      }
    },
    "production": {
      "name": "pirate-web-solid-production",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
