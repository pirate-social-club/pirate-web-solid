{
  "name": "pirate-web-solid",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/solid-ui"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-solid-runtime.mjs && node scripts/check-api-client-provenance.mjs",
    "build": "vite build && node scripts/prune-solid-ssr-optional-assets.mjs",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006} --disable-telemetry",
    "build-storybook": "storybook build",
    "generate:phosphor-icons": "bun scripts/generate-phosphor-icons.ts",
    "check:phosphor-icons": "bun scripts/generate-phosphor-icons.ts --check",
    "generate:web3-icons": "bun scripts/generate-web3-icons.ts",
    "check:web3-icons": "bun scripts/generate-web3-icons.ts --check",
    "storybook:a11y": "node scripts/storybook-a11y-sweep.mjs",
    "test:storybook:a11y": "bun test scripts/storybook-a11y-sweep.test.mjs",
    "check-product-graph": "node scripts/check-product-graph.mjs --require-build",
    "test:app": "vitest run --config vitest.app.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts src/api src/hns-ingress src/worker.test.ts",
    "check:e2e": "tsc --noEmit -p e2e/tsconfig.json && playwright test -c e2e --list",
    "test:e2e": "playwright test -c e2e --grep @staging-readonly",
    "test:e2e:staging": "E2E_BASE_URL=https://web-next-staging.pirate.sc playwright test -c e2e --grep @staging-readonly",
    "test:e2e:staging:mutating": "E2E_BASE_URL=https://web-next-staging.pirate.sc playwright test -c e2e --grep @staging-mutating",
    "test:e2e:staging:manual": "E2E_BASE_URL=https://web-next-staging.pirate.sc playwright test -c e2e --grep @staging-manual",
    "dev": "vite dev --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "probe": "node scripts/probe.mjs",
    "stream-check": "node scripts/stream-check.mjs",
    "hydration-check": "node scripts/hydration-check.mjs",
    "post-engagement-check": "node scripts/post-engagement-check.mjs",
    "text-post-check": "node scripts/text-post-check.mjs",
    "karaoke-route-check": "node scripts/karaoke-route-check.mjs",
    "check-solid-runtime": "node scripts/check-solid-runtime.mjs",
    "check-api-client-provenance": "node scripts/check-api-client-provenance.mjs",
    "check:solid-doctor": "solid-doctor . --baseline .solid-doctor-baseline.json",
    "configure:radicle-primary": "scripts/configure-radicle-primary",
    "publish:main": "scripts/publish-main",
    "test:publish-main": "scripts/publish-main.test.sh",
    "test:production-config": "node scripts/production-config.test.mjs",
    "lint": "oxlint src",
    "generate-worker-types": "wrangler types",
    "verify": "bun run generate-worker-types && bun run test:production-config && bun run tsc --noEmit -p tsconfig.json && bun run check:e2e && bun run test:api && bun run test:app && bun run lint && node scripts/check-solid-runtime.mjs && node scripts/check-api-client-provenance.mjs && bun run check:web3-icons && bun run check:phosphor-icons && bun run --cwd packages/solid-ui typecheck && bun run --cwd packages/solid-ui test && bun run check:solid-doctor",
    "verify:live": "node scripts/probe.mjs && node scripts/stream-check.mjs && node scripts/hydration-check.mjs"
  },
  "dependencies": {
    "@pirate/api-client": "file:vendor/api-client/pirate-api-client-0.25.0.tgz",
    "@pirate/api-client-community-route": "file:vendor/api-client/pirate-api-client-0.13.0.tgz",
    "@pirate/api-client-handle-sales": "file:vendor/api-client/pirate-api-client-0.21.0.tgz",
    "@pirate/web-solid-ui": "workspace:*",
    "@privy-io/js-sdk-core": "0.70.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "@veryai/widget": "1.0.22",
    "@zkpassport/sdk": "0.14.2",
    "filesystem-routing": "0.2.1",
    "qrcode": "1.5.4",
    "qr-code-styling": "1.9.2",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@oxlint/plugins": "1.78.0",
    "@phosphor-icons/core": "2.1.1",
    "@solidjs/vite-plugin": "3.0.0-next.27",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@testing-library/jest-dom": "7.0.1",
    "remark-gfm": "4.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.6",
    "@web3icons/react": "4.1.17",
    "bun-types": "1.4.0",
    "oxlint": "1.78.0",
    "playwright": "1.60.0",
    "solid-doctor": "0.1.0",
    "storybook": "10.5.10",
    "storybook-solidjs-vite": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "patchedDependencies": {
    "jsdom@30.0.0": "packages/solid-ui/patches/jsdom@30.0.0.patch",
    "@veryai/widget@1.0.22": "patches/@veryai%2Fwidget@1.0.22.patch"
  },
  "overrides": {
    "@storybook/builder-vite": "10.5.10",
    "@storybook/csf-plugin": "10.5.10"
  }
}
