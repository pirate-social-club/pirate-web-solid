{
  "name": "pirate-web-solid",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": ["packages/solid-ui"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-solid-runtime.mjs",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build",
    "storybook:a11y": "node scripts/storybook-a11y-sweep.mjs",
    "test:storybook:a11y": "bun test scripts/storybook-a11y-sweep.test.mjs",
    "check-product-graph": "node scripts/check-product-graph.mjs --require-build",
    "test:app": "vitest run --config vitest.app.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts src/api",
    "dev": "vite dev --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "probe": "node scripts/probe.mjs",
    "stream-check": "node scripts/stream-check.mjs",
    "hydration-check": "node scripts/hydration-check.mjs",
    "karaoke-route-check": "node scripts/karaoke-route-check.mjs",
    "check-solid-runtime": "node scripts/check-solid-runtime.mjs",
    "check:solid-doctor": "solid-doctor . --baseline .solid-doctor-baseline.json",
    "lint": "oxlint src",
    "generate-worker-types": "wrangler types",
    "verify": "bun run generate-worker-types && bun run tsc --noEmit -p tsconfig.json && bun run test:api && bun run test:app && bun run lint && node scripts/check-solid-runtime.mjs && bun run --cwd packages/solid-ui typecheck && bun run --cwd packages/solid-ui test && bun run check:solid-doctor",
    "verify:live": "node scripts/probe.mjs && node scripts/stream-check.mjs && node scripts/hydration-check.mjs"
  },
  "dependencies": {
    "@pirate/api-client": "file:vendor/api-client/pirate-api-client-0.7.0.tgz",
    "@pirate/web-solid-ui": "workspace:*",
    "@privy-io/js-sdk-core": "0.70.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "@zkpassport/sdk": "0.14.2",
    "filesystem-routing": "0.2.1",
    "qrcode": "1.5.4",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@oxlint/plugins": "1.78.0",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@solidjs/vite-plugin": "3.0.0-next.27",
    "@testing-library/jest-dom": "7.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.6",
    "oxlint": "1.78.0",
    "playwright": "1.60.0",
    "solid-doctor": "0.1.0",
    "storybook": "10.5.8",
    "storybook-solidjs-vite": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "patchedDependencies": {
    "jsdom@30.0.0": "packages/solid-ui/patches/jsdom@30.0.0.patch"
  }
}
