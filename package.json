{
  "name": "pirate-web-solid",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": ["../solid-storybook-poc"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-solid-runtime.mjs",
    "build": "vite build",
    "dev": "vite dev --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "probe": "node scripts/probe.mjs",
    "api-origin-test": "bun test src/lib/api/origin.test.ts",
    "stream-check": "node scripts/stream-check.mjs",
    "hydration-check": "node scripts/hydration-check.mjs",
    "check-solid-runtime": "node scripts/check-solid-runtime.mjs",
    "verify": "tsc --noEmit -p tsconfig.json && node scripts/check-solid-runtime.mjs && bun test src/lib/api/origin.test.ts && node scripts/probe.mjs && node scripts/stream-check.mjs && node scripts/hydration-check.mjs"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "@tanstack/solid-query": "6.0.0-rc.0",
    "class-variance-authority": "0.7.1",
    "filesystem-routing": "0.2.1",
    "pirate-solid-design-system": "workspace:*",
    "solid-js": "2.0.0-rc.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260813.1",
    "@solidjs/vite-plugin": "3.0.0-next.27",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@tailwindcss/vite": "4.3.3",
    "playwright": "1.60.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "patchedDependencies": {
    "@kobalte/core@2.0.0-alpha.0": "patches/@kobalte%2Fcore@2.0.0-alpha.0.patch"
  }
}
